# tuned/repo.env -- vllm-specific settings for tuned builds. Sourced by tuned/env.sh after the shared
# device and toolkit definitions (tuned/common-data, vendored from zbrad/tuned-common). Tracked, so a
# release is reproducible.
#
# This file only ADDS repo-specific settings. Changing a shared key (GPU_TUNED_VARIANT/PLATFORM/CUDA_ARCH/
# HW_LABEL, CUDA_*, TOOLKIT_*) is a loud error from gpu_tuned_load_repo_env. Plain assignment on purpose:
# this file is sourced inside a function, where `declare` would make the variable local and lose it.

# Upstream ref the build-info stamp and the DRAFT notes compare against (the merge-base of HEAD with it).
GPU_TUNED_UPSTREAM_REF="${GPU_TUNED_UPSTREAM_REF:-upstream/main}"

# vllm's TORCH_CUDA_ARCH_LIST spelling is dotted ("12.1a", "8.9"); the shared device files carry the
# resolved cuobjdump form ("121a", "89"). Insert the dot before the last digit.
GPU_TUNED_TORCH_ARCH="$(printf '%s' "${GPU_TUNED_CUDA_ARCH}" | sed -E 's/^([0-9]+)([0-9])(a?)$/\1.\2\3/')"

case "${GPU_TUNED_VARIANT}" in
    gb10)
        # GB10 is not in vllm's supported arch matrix and no aarch64/sm_121 wheel of torch or
        # flash-attention exists upstream, so both are prebuilt personal-fork wheels. torch is pinned in
        # requirements/gb10.txt (a normal `@ URL` dependency; that file cannot move: setup.py reads it).
        # vllm_flash_attn is not in requirements/gb10.txt: it must be importable before vllm's CMake
        # configure step, which copies it from the installed package (VLLM_FLASH_ATTN_PREBUILT_PKG).
        GPU_TUNED_NEEDS_PREBUILT_DEPS="true"
        GPU_TUNED_FLASH_ATTN_WHEEL_URL="https://github.com/zbrad/flash-attention-vllm/releases/download/v2.7.2.post1%2Bgb10.cu134.20261028.0/vllm_flash_attn-2.7.2.post1%2Bgb10.cu134.20261028.0-cp314-cp314-linux_aarch64.whl"
        # The pinned torch, flash-attention and flashinfer wheels are built for cu134 only.
        GPU_TUNED_REPO_TOOLKITS="cu134"
        GPU_TUNED_REPO_TOOLKIT_REASON="The pinned torch (requirements/gb10.txt), flash-attention (GPU_TUNED_FLASH_ATTN_WHEEL_URL in tuned/repo.env) and flashinfer wheels exist for cu134 only; build with CUDA_TAG=cu134."
        ;;
    rtx40|rtx50)
        # Upstream builds these with its own PyPI torch and flash-attention (FetchContent), so no prebuilt
        # dependency is pinned here. Not built from this repo yet: untested.
        GPU_TUNED_NEEDS_PREBUILT_DEPS="false"
        GPU_TUNED_FLASH_ATTN_WHEEL_URL=""
        GPU_TUNED_REPO_TOOLKITS=""
        GPU_TUNED_REPO_TOOLKIT_REASON=""
        ;;
    *)
        echo "ERROR: tuned/repo.env has no settings for variant '${GPU_TUNED_VARIANT}' (gb10, rtx40, rtx50)." >&2
        return 1
        ;;
esac

# Strings the fork keeps in upstream-owned files; tools/upstream-sync.sh (GPU_TUNED_FORK_MARKERS in its environment,
# comma-separated) refuses a merge that loses one. The second marks the 12.1 entry restored in CMakeLists.txt for CUDA 13.4.
GPU_TUNED_FORK_MARKERS="gpu_tuned_,zbrad/vllm tuned-builds: keep 12.1,VLLM_TUNED_NATIVE_ONLY"
